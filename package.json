{
  "name": "nexmax-it-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:content": "tsx scripts/lint_content.ts",
    "lint:secrets": "secretlint --secretlintignore .secretlintignore \"**/*\"",
    "furigana:suggest": "tsx scripts/suggest_furigana.ts",
    "assets:fetch": "node scripts/fetch_assets.mjs",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm run lint:content && npm test",
    "prepare": "husky",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "kuromoji": "^0.1.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^14.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
